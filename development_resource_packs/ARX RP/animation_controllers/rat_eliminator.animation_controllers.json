{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.rat_eliminator.main": {
			"initial_state": "idle",
			"states": {
				"idle": {
					"animations": ["stay"],
					"transitions": [
						{"walking": "q.ground_speed > 1.0"},
						{"attack": "variable.attack_time > 0.0"}
					],
					"blend_transition": 0.2
				},
				"walking": {
					"animations": ["stay", "walk"],
					"transitions": [
						{"idle": "q.ground_speed < 0.5"},
						{"attack": "variable.attack_time > 0.0"}
					],
					"blend_transition": 0.3
				},
				"attack": {
					"animations": ["stay", "attack"],
					"transitions": [
						{"idle": "query.anim_time > 3"}
					],
					"blend_transition": 0.1
				}
			}
		}
	}
}