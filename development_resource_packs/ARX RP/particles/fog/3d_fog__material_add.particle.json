// Implies launching from JS with custom variables
{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "arx:3d_fog__material_add",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/fog/3d_fog"
			}
		},
		"curves": {
			"variable.opacity": {
				"type": "catmull_rom",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [-0.59, 0, 1, 0, -0.7]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": "v.intensity",
				"max_particles": 1024
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": "v.lifetime"
			},
			"minecraft:emitter_shape_box": {
				"offset": [0, 0.2, 0],
				"half_dimensions": ["v.range", 0.5, "v.range"],
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1, 2)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0, 360)",
				"rotation_rate": "math.random(-40, 40)"
			},
			"minecraft:particle_initial_speed": "math.random(0, 1.5)",
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": [2.2, 2.2],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 1,
					"texture_height": 1,
					"uv": [0, 0],
					"uv_size": [1, 1]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["v.color.r", "v.color.g", "v.color.b", "variable.opacity * 0.10"]
			}
		}
	}
}